# Copy to .env with `make env`. Only digests live here: sha256(HASH_SALT + raw key), hex.
# Dev raw keys (compute digests with `make key RAW=…`):
#   brightcart  read    airtg_read_local_dev
#   brightcart  execute airtg_exec_local_dev
#   othershop   read    airtg_read_othershop_dev
#   othershop   execute airtg_exec_othershop_dev
AIR_TOOLS_GATEWAY__APP__ENV=development
AIR_TOOLS_GATEWAY__HTTP__PORT=8080
AIR_TOOLS_GATEWAY__SECURITY__HASH_SALT=air-tools-gateway-dev-salt
AIR_TOOLS_GATEWAY__SECURITY__API_KEYS=[{"id":"brightcart-read","tenant":"brightcart","scope":"read","key_hash":"b3f0f6f1af42deec3de69f9717b3362b9c1d8cb014d01699547e4ca9ed4bb72b"},{"id":"brightcart-exec","tenant":"brightcart","scope":"execute","key_hash":"b5bd994a84a0b2108775a03e098dd26c93a73d25a7b15d53f21307e23d785330"},{"id":"othershop-read","tenant":"othershop","scope":"read","key_hash":"78ed0c8f906097ad1cc9eae45ebc65971a137c245c2893c25157ac411100d9f9"},{"id":"othershop-exec","tenant":"othershop","scope":"execute","key_hash":"a5fdaaaa76957070d241a89877d6614fca6e63159b2c1ad082697fe903ec506e"}]
AIR_TOOLS_GATEWAY__BACKEND__MODE=fixture
AIR_TOOLS_GATEWAY__BACKEND__FIXTURE_DIR=fixtures
AIR_TOOLS_GATEWAY__ACTIONS__PROPOSAL_TTL_S=600
AIR_TOOLS_GATEWAY__ACTIONS__IDEMPOTENCY_TTL_S=86400
AIR_TOOLS_GATEWAY__LOG__FORMAT=json
